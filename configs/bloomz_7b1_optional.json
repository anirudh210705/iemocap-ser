{
  "seed": 42,
  "data_root": "data",
  "train_csv": "artifacts/splits/fixed/train.csv",
  "val_csv": "artifacts/splits/fixed/val.csv",
  "output_dir": "artifacts/runs/bloomz_7b1_optional",
  "model": "wav2vec2_llm",
  "pretrained_name": "facebook/wav2vec2-base",
  "llm_name": "bigscience/bloomz-7b1",
  "prompt": "Classify the emotion expressed in the preceding speech. Possible emotions: angry, happy, neutral, sad. Answer with one emotion:",
  "emotion_verbalizers": {"angry": "angry", "happy": "happy", "neutral": "neutral", "sad": "sad"},
  "sample_rate": 16000,
  "max_seconds": 12.0,
  "batch_size": 1,
  "gradient_accumulation_steps": 32,
  "num_workers": 2,
  "epochs": 20,
  "learning_rate": 0.00003,
  "encoder_learning_rate": 0.00001,
  "head_learning_rate": 0.0001,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "max_grad_norm": 1.0,
  "patience": 5,
  "freeze_feature_encoder": true,
  "freeze_transformer_layers": 8,
  "projector_dropout": 0.1,
  "llm_dtype": "bfloat16",
  "gradient_checkpointing": true,
  "augmentation": "none",
  "mixup_alpha": 0.0,
  "class_weighted_loss": true
}
